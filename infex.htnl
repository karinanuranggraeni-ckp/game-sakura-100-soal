const QUESTIONS=RAW.map(r=>({cat:r[0],q:r[1],hint:r[2],a:r[3],correct:r[4]}));
if(QUESTIONS.length!==TOTAL)throw new Error("Jumlah soal harus tepat 100.");

let saved=loadData(),state="menu",questions=[],questionIndex=0;
let score=0,lives=3,correctTotal=0,wrongTotal=0,answered=false;
let audio=null,wakeLock=null,beforeUnloadActive=false;
let rafId=0,lastFrame=0,sceneTime=0,resizeTimer=0;
let petalItems=[],petalW=0,petalH=0;

function loadData(){
 try{
  const raw=localStorage.getItem(STORAGE_KEY);
  if(!raw)return {...DEFAULTS};
  const d=JSON.parse(raw);
  if(!d||d.version!==1)return {...DEFAULTS};
  return {
   ...DEFAULTS,best:Number.isFinite(d.best)&&d.best>=0?d.best:0,
   sfx:typeof d.sfx==="boolean"?d.sfx:true,
   difficulty:["mudah","normal","sulit"].includes(d.difficulty)?d.difficulty:"mudah",
   onboarded:!!d.onboarded
  };
 }catch(e){return {...DEFAULTS};}
}
function saveData(){
 try{localStorage.setItem(STORAGE_KEY,JSON.stringify(saved));return true;}
 catch(e){$("message").textContent="Penyimpanan browser penuh atau diblokir. Reset data jika diperlukan.";return false;}
}
function showScreen(id){
 document.querySelectorAll(".screen").forEach(s=>s.classList.remove("active"));
 $(id).classList.add("active");
}
function updateHome(){
 $("bestHome").textContent=saved.best;
 $("bestSetting").textContent=saved.best;
 $("sideBest").textContent=saved.best;
 $("sfxToggle").textContent=saved.sfx?"Aktif":"Mati";
 $("sfxToggle").classList.toggle("on",saved.sfx);
 $("sfxToggle").setAttribute("aria-pressed",String(saved.sfx));
 $("soundButton").textContent=saved.sfx?"♪":"♪̸";
 $("difficulty").value=saved.difficulty;
}
function initAudio(){
 try{
  if(!audio){
   const AC=window.AudioContext||window.webkitAudioContext;
   if(!AC)return;
   audio=new AC();
  }
  if(audio.state==="suspended")audio.resume().catch(()=>{});
 }catch(e){audio=null;}
}
function beep(type){
 if(!saved.sfx)return;
 try{
  initAudio();if(!audio||audio.state!=="running")return;
  const o=audio.createOscillator(),g=audio.createGain();
  o.type="sine";o.frequency.value=type==="good"?660:type==="bad"?190:480;
  g.gain.setValueAtTime(.07,audio.currentTime);
  g.gain.exponentialRampToValueAtTime(.001,audio.currentTime+.18);
  o.connect(g);g.connect(audio.destination);
  o.start();o.stop(audio.currentTime+.18);
 }catch(e){}
}
async function requestWakeLock(){
 try{if("wakeLock"in navigator&&state==="playing")wakeLock=await navigator.wakeLock.request("screen");}
 catch(e){wakeLock=null;}
}
async function releaseWakeLock(){
 try{if(wakeLock){await wakeLock.release();wakeLock=null;}}
 catch(e){wakeLock=null;}
}
function startGame(){
 initAudio();
 questions=[...QUESTIONS];
 for(let i=questions.length-1;i>0;i--){
  const j=Math.floor(Math.random()*(i+1));
  [questions[i],questions[j]]=[questions[j],questions[i]];
 }
 questionIndex=0;score=0;correctTotal=0;wrongTotal=0;answered=false;
 lives=saved.difficulty==="mudah"?10:saved.difficulty==="normal"?5:3;
 state="playing";beforeUnloadActive=true;
 $("pauseOverlay").classList.remove("show");
 $("confirmOverlay").classList.remove("show");
 showScreen("gameScreen");
 renderQuestion();updateStats();requestWakeLock();
}
function renderQuestion(){
 const q=questions[questionIndex];
 if(!q){finishGame(true);return;}
 answered=false;
 $("category").textContent=q.cat;
 $("question").textContent=q.q;
 $("questionHint").textContent="Cara baca: "+q.hint+" — Pilih jawaban yang benar.";
 $("feedback").textContent="Pilih jawabanmu, ya!";
 $("feedback").className="feedback";
 $("nextButton").disabled=true;
 $("nextButton").textContent=questionIndex===TOTAL-1?"Lihat hasil":"Berikutnya →";
 $("answers").replaceChildren();
 q.a.forEach((answer,index)=>{
  const b=document.createElement("button");
  b.className="answer";
  const letter=document.createElement("span");
  letter.className="letter";
  letter.textContent=String.fromCharCode(65+index);
  const text=document.createElement("span");
  text.textContent=answer;
  b.append(letter,text);
  b.setAttribute("aria-label","Jawaban "+String.fromCharCode(65+index)+": "+answer);
  b.addEventListener("click",()=>chooseAnswer(index));
  $("answers").appendChild(b);
 });
 updateStats();
}
function updateStats(){
 $("score").textContent=score;
 $("sideScore").textContent=score;
 $("lives").textContent=lives>0?"♥ ".repeat(lives).trim():"0";
 $("round").textContent=(questionIndex+1)+"/"+TOTAL;
 $("progressFill").style.width=(questionIndex/TOTAL*100)+"%";
}
function chooseAnswer(index){
 if(state!=="playing"||answered)return;
 const q=questions[questionIndex];if(!q)return;
 answered=true;
 [...$("answers").querySelectorAll("button")].forEach((b,i)=>{
  b.disabled=true;
  if(i===q.correct)b.classList.add("correct");
  if(i===index&&i!==q.correct)b.classList.add("wrong");
 });
 if(index===q.correct){
  score+=10;correctTotal++;
  $("feedback").textContent="Benar! よくできました — Bagus sekali! +10 poin.";
  $("feedback").className="feedback good";beep("good");
 }else{
  lives--;wrongTotal++;
  $("feedback").textContent="Belum tepat. Jawaban yang benar: "+q.a[q.correct]+". Tetap semangat!";
  $("feedback").className="feedback bad";beep("bad");
 }
 updateStats();
 $("nextButton").disabled=false;
 if(lives<=0)$("nextButton").textContent="Lihat hasil";
}
function nextQuestion(){
 if(state!=="playing"||!answered)return;
 if(lives<=0||questionIndex===TOTAL-1){finishGame(lives>0&&questionIndex===TOTAL-1);return;}
 questionIndex++;renderQuestion();
}
function finishGame(won){
 state=won?"win":"gameover";beforeUnloadActive=false;releaseWakeLock();
 const old=saved.best;if(score>saved.best)saved.best=score;
 saveData();
 $("resultEmoji").textContent=won?"🌸":"🍃";
 $("resultTitle").textContent=won?"おめでとう! Selamat!":"Jangan menyerah!";
 $("resultDescription").textContent=won?
  "Kamu menyelesaikan seluruh 100 pertanyaan bersama Hana!":
  "Kesempatanmu sudah habis. Pelajari kembali kosakata dan coba lagi.";
 $("finalScore").textContent=score;
 $("correctCount").textContent=correctTotal;
 $("wrongCount").textContent=wrongTotal;
 $("newRecord").textContent=score>old?"🏆 Rekor baru! Hebat!":"Rekor terbaik: "+saved.best+" poin.";
 updateHome();showScreen("resultScreen");
}
function pauseGame(){
 if(state!=="playing")return;
 state="paused";releaseWakeLock();
 if(audio&&audio.state==="running")audio.suspend().catch(()=>{});
 $("pauseOverlay").classList.add("show");$("resumeButton").focus();
}
function resumeGame(){
 if(state!=="paused")return;
 state="playing";$("pauseOverlay").classList.remove("show");
 initAudio();requestWakeLock();
}
function returnHome(){
 state="menu";beforeUnloadActive=false;releaseWakeLock();
 $("pauseOverlay").classList.remove("show");
 $("confirmOverlay").classList.remove("show");
 showScreen("homeScreen");updateHome();
}
function askRestart(){
 if(state==="playing"||state==="paused")$("confirmOverlay").classList.add("show");
 else startGame();
}
function toggleSound(){
 saved.sfx=!saved.sfx;saveData();updateHome();
 if(saved.sfx){initAudio();beep("tap");}
}
async function toggleFullscreen(){
 try{
  if(!document.fullscreenElement){
   if(document.documentElement.requestFullscreen)await document.documentElement.requestFullscreen();
   else $("message").textContent="Layar penuh tidak didukung browser ini.";
  }else if(document.exitFullscreen)await document.exitFullscreen();
 }catch(e){$("message").textContent="Layar penuh tidak tersedia. Gunakan menu browser.";}
}
function resetData(){
 if(!confirm("Hapus skor terbaik dan semua pengaturan tersimpan?"))return;
 saved={...DEFAULTS};saveData();updateHome();
 $("message").textContent="Data berhasil direset.";
}
function startOnboarding(){
 if(!saved.onboarded)$("onboardOverlay").classList.add("show");
 else startGame();
}
function completeOnboarding(){
 saved.onboarded=true;saveData();
 $("onboardOverlay").classList.remove("show");startGame();
}
function handleKey(e){
 const tag=document.activeElement?.tagName;
 if(tag==="SELECT"||tag==="INPUT"||tag==="TEXTAREA")return;
 const key=e.key.toLowerCase();
 if(key==="escape"||key==="p"){
  e.preventDefault();
  if(state==="playing")pauseGame();else if(state==="paused")resumeGame();
  return;
 }
 if(key==="m"){toggleSound();return;}
 if(key==="f"){toggleFullscreen();return;}
 if(key==="r"){if(state==="playing"||state==="paused")askRestart();return;}
 if(state==="playing"){
  if(["1","2","3","4"].includes(e.key))chooseAnswer(Number(e.key)-1);
  else if(e.key==="Enter"||e.key===" "){if(answered)nextQuestion();}
 }else if(state==="menu"&&(e.key==="Enter"||e.key===" ")){
  startOnboarding();
 }
}
$("startButton").addEventListener("click",startOnboarding);
$("howButton").addEventListener("click",()=>showScreen("howScreen"));
$("howBack").addEventListener("click",()=>showScreen("homeScreen"));
$("settingsButton").addEventListener("click",()=>{showScreen("settingsScreen");updateHome();});
$("pauseButton").addEventListener("click",pauseGame);
$("resumeButton").addEventListener("click",resumeGame);
$("nextButton").addEventListener("click",nextQuestion);
$("replayButton").addEventListener("click",startGame);
$("homeButton").addEventListener("click",returnHome);
$("exitButton").addEventListener("click",returnHome);
$("pauseRestart").addEventListener("click",askRestart);
$("confirmYes").addEventListener("click",startGame);
$("confirmNo").addEventListener("click",()=>$("confirmOverlay").classList.remove("show"));
$("onboardStart").addEventListener("click",completeOnboarding);
$("onboardSkip").addEventListener("click",completeOnboarding);
$("soundButton").addEventListener("click",toggleSound);
$("fullscreenButton").addEventListener("click",toggleFullscreen);
$("sfxToggle").addEventListener("click",toggleSound);
$("difficulty").addEventListener("change",e=>{
 saved.difficulty=e.target.value;saveData();
});
$("settingsBack").addEventListener("click",()=>{
 updateHome();showScreen(state==="paused"?"gameScreen":"homeScreen");
});
$("resetData").addEventListener("click",resetData);
window.addEventListener("keydown",e=>{try{handleKey(e);}catch(err){showFatal();}});
window.addEventListener("blur",()=>{if(state==="playing")pauseGame();});
document.addEventListener("visibilitychange",()=>{
 if(document.hidden){
  if(state==="playing")pauseGame();
  if(audio&&audio.state==="running")audio.suspend().catch(()=>{});
 }else if(state==="playing")initAudio();
});
window.addEventListener("beforeunload",e=>{
 if(beforeUnloadActive){e.preventDefault();e.returnValue="";}
});
history.pushState({sakura:true},"",location.href);
window.addEventListener("popstate",()=>{
 if(state==="playing")pauseGame();else if(state==="paused")returnHome();
 history.pushState({sakura:true},"",location.href);
});
function showFatal(){$("fatalError").classList.add("show");}
window.addEventListener("error",showFatal);

/* Ilustrasi sekolah dan Hana digambar langsung di Canvas. */
const scene=$("scene"),sceneCtx=scene.getContext("2d");
const petals=$("petals"),petalCtx=petals.getContext("2d");
const reduced=window.matchMedia("(prefers-reduced-motion: reduce)").matches;
const saveDataMode=navigator.connection?.saveData===true;
function drawScene(){
 if(!sceneCtx)return;
 const c=sceneCtx,w=600,h=620;
 c.clearRect(0,0,w,h);
 const sky=c.createLinearGradient(0,0,0,h);
 sky.addColorStop(0,"#dcebdc");sky.addColorStop(1,"#f4e7d7");
 c.fillStyle=sky;c.fillRect(0,0,w,h);
 c.fillStyle="#b9c6a6";c.fillRect(0,270,600,190);
 c.fillStyle="#e9d3b8";c.fillRect(80,220,440,230);
 c.fillStyle="#8b705e";c.fillRect(65,210,470,24);
 for(let x=110;x<510;x+=100){
  c.fillStyle="#a87866";c.fillRect(x,270,65,80);
  c.fillStyle="#d8e8df";c.fillRect(x+8,278,49,62);
  c.strokeStyle="#fff5e6";c.lineWidth=4;
  c.beginPath();c.moveTo(x+32,278);c.lineTo(x+32,340);c.stroke();
 }
 c.fillStyle="#846d5e";c.fillRect(245,350,110,100);
 c.fillStyle="#d8e8df";c.fillRect(260,360,80,90);
 c.fillStyle="#94a77d";c.fillRect(0,450,600,170);
 c.fillStyle="#ddc5a7";c.beginPath();c.moveTo(230,450);c.lineTo(370,450);c.lineTo(500,620);c.lineTo(100,620);c.closePath();c.fill();
 c.fillStyle="#76543e";c.fillRect(50,250,25,280);
 c.strokeStyle="#76543e";c.lineWidth=17;c.beginPath();c.moveTo(65,310);c.lineTo(125,200);c.moveTo(65,345);c.lineTo(10,260);c.stroke();
 [[60,150,75],[130,120,60],[15,210,55],[100,220,62],[170,190,50],[40,90,45]].forEach(([x,y,r],i)=>{
  c.fillStyle=i%2?"#e9a9bb":"#f2bfd0";
  c.beginPath();c.arc(x,y,r,0,Math.PI*2);c.fill();
  for(let j=0;j<6;j++){
   const a=j*Math.PI/3;c.fillStyle="#fff0e5";
   c.beginPath();c.arc(x+Math.cos(a)*r*.45,y+Math.sin(a)*r*.45,r*.2,0,Math.PI*2);c.fill();
  }
 });
 c.save();c.translate(385,385);
 c.fillStyle="#3e302f";c.beginPath();c.ellipse(0,-75,64,77,0,0,Math.PI*2);c.fill();
 c.fillStyle="#f1c9ac";c.beginPath();c.ellipse(0,-72,47,56,0,0,Math.PI*2);c.fill();
 c.fillStyle="#3e302f";c.beginPath();c.ellipse(-38,-105,27,44,-.4,0,Math.PI*2);c.ellipse(39,-105,25,44,.4,0,Math.PI*2);c.fill();
 c.beginPath();c.moveTo(-46,-98);c.quadraticCurveTo(-25,-155,10,-127);c.quadraticCurveTo(37,-151,47,-96);c.quadraticCurveTo(12,-112,0,-95);c.quadraticCurveTo(-20,-112,-46,-98);c.fill();
 c.fillStyle="#493332";c.beginPath();c.ellipse(-17,-74,4,7,0,0,Math.PI*2);c.ellipse(17,-74,4,7,0,0,Math.PI*2);c.fill();
 c.strokeStyle="#a85d66";c.lineWidth=2;c.beginPath();c.arc(0,-57,9,.2,Math.PI-.2);c.stroke();
 c.fillStyle="#ed9eaa";c.beginPath();c.arc(-28,-57,8,0,Math.PI*2);c.arc(28,-57,8,0,Math.PI*2);c.fill();
 c.fillStyle="#d989a5";c.beginPath();c.moveTo(28,-133);c.lineTo(63,-149);c.lineTo(55,-119);c.closePath();c.fill();
 c.beginPath();c.moveTo(28,-133);c.lineTo(1,-155);c.lineTo(10,-123);c.closePath();c.fill();
 c.fillStyle="#f8eee2";c.beginPath();c.moveTo(-35,-18);c.lineTo(35,-18);c.lineTo(55,125);c.lineTo(-55,125);c.closePath();c.fill();
 c.fillStyle="#526e61";c.beginPath();c.moveTo(-42,38);c.lineTo(42,38);c.lineTo(52,125);c.lineTo(-52,125);c.closePath();c.fill();
 c.fillStyle="#d989a5";c.beginPath();c.moveTo(-12,-16);c.lineTo(12,-16);c.lineTo(0,20);c.closePath();c.fill();
 c.fillStyle="#3e302f";c.beginPath();c.ellipse(-25,134,13,8,0,0,Math.PI*2);c.ellipse(25,134,13,8,0,0,Math.PI*2);c.fill();
 c.restore();
 c.fillStyle="#fff8ed";c.beginPath();c.roundRect(185,55,225,46,13);c.fill();
 c.fillStyle="#873c59";c.font="bold 20px Georgia";c.textAlign="center";c.fillText("さくら学園",297,85);
 c.font="13px Trebuchet MS";c.fillStyle="#536d55";c.fillText("Sakura Academy",297,116);
}
function resizePetals(){
 const rect=petals.getBoundingClientRect();petalW=rect.width;petalH=rect.height;
 const dpr=Math.min(devicePixelRatio||1,2);
 petals.width=Math.round(petalW*dpr);petals.height=Math.round(petalH*dpr);
 petalCtx.setTransform(1,0,0,1,0,0);petalCtx.scale(dpr,dpr);
 const count=reduced||saveDataMode?0:35;
 petalItems=Array.from({length:count},()=>({
  x:Math.random()*petalW,y:Math.random()*petalH,
  speed:15+Math.random()*28,size:3+Math.random()*4,
  sway:Math.random()*6,phase:Math.random()*6
 }));
}
function drawPetals(dt){
 if(!petalCtx)return;
 petalCtx.clearRect(0,0,petalW,petalH);
 if(state==="paused"||document.hidden)return;
 petalItems.forEach(p=>{
  p.y+=p.speed*dt;p.x+=Math.sin(sceneTime+p.phase)*p.sway*dt;
  if(p.y>petalH+10){p.y=-10;p.x=Math.random()*petalW;}
  petalCtx.save();petalCtx.translate(p.x,p.y);petalCtx.rotate(sceneTime+p.phase);
  petalCtx.fillStyle="rgba(217,137,165,.72)";
  petalCtx.beginPath();petalCtx.ellipse(0,0,p.size,p.size*.55,.3,0,Math.PI*2);petalCtx.fill();
  petalCtx.restore();
 });
}
function frame(time){
 rafId=requestAnimationFrame(frame);
 const dt=lastFrame?Math.min((time-lastFrame)/1000,.05):0;
 lastFrame=time;
 if(state!=="paused"&&!document.hidden)sceneTime+=dt;
 drawPetals(dt);
}
function resizeAll(){try{drawScene();resizePetals();}catch(e){showFatal();}}
function scheduleResize(){clearTimeout(resizeTimer);resizeTimer=setTimeout(resizeAll,180);}
window.addEventListener("resize",scheduleResize);
window.addEventListener("orientationchange",scheduleResize);
window.visualViewport?.addEventListener("resize",scheduleResize);
screen.orientation?.addEventListener?.("change",scheduleResize);
scene.addEventListener("contextmenu",e=>e.preventDefault());
scene.addEventListener("dragstart",e=>e.preventDefault());
petals.addEventListener("contextmenu",e=>e.preventDefault());
petals.addEventListener("dragstart",e=>e.preventDefault());

function boot(){
 try{
  updateHome();resizeAll();
  if(rafId)cancelAnimationFrame(rafId);
  rafId=requestAnimationFrame(frame);
  if(!saved.onboarded)$("onboardOverlay").classList.add("show");
 }catch(e){showFatal();}
}
boot();
</script>
</body>
</html>
