
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="description" content="Sakura School: game belajar 100 pertanyaan bahasa Jepang di sekolah musim sakura.">
<meta name="author" content="Sakura Studio">
<meta name="theme-color" content="#d989a5">
<meta name="color-scheme" content="light">
<meta name="format-detection" content="telephone=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Sakura School">
<meta name="mobile-web-app-capable" content="yes">
<meta property="og:type" content="game">
<meta property="og:title" content="Sakura School">
<meta property="og:description" content="Petualangan 100 pertanyaan bahasa Jepang bersama Hana.">
<meta property="og:locale" content="id_ID">
<meta property="og:site_name" content="Sakura School">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Sakura School">
<meta name="twitter:description" content="Game belajar bahasa Jepang dengan 100 pertanyaan.">
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='25' fill='%23d989a5'/%3E%3Cpath d='M50 12 Q60 35 85 40 Q62 48 50 75 Q38 48 15 40 Q40 35 50 12Z' fill='%23fff0e6'/%3E%3C/svg%3E">
<title>Sakura School — 100 Pertanyaan Bahasa Jepang</title>
<style>
:root{
 --pink:#d989a5;--pinkdark:#873c59;--green:#617b61;
 --darkgreen:#314c39;--cream:#f3e8d5;--paper:#fff8ed;
 --ink:#382e2b;--muted:#74645d;--line:#dfc9b7;
 --good:#356c4a;--bad:#a43e43;
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;overscroll-behavior:none}
body{
 font-family:"Trebuchet MS",Verdana,sans-serif;
 color:var(--ink);background:var(--cream);
 min-height:100vh;min-height:100dvh;
 overflow-x:hidden;touch-action:manipulation;
}
button,select{font:inherit}
button{
 min-height:46px;padding:12px 17px;border:0;border-radius:12px;
 font-weight:bold;cursor:pointer;color:var(--ink);
 transition:transform .15s,background .15s;
 -webkit-tap-highlight-color:transparent;
 user-select:none;
}
button:hover:not(:disabled){transform:translateY(-2px)}
button:active:not(:disabled){transform:scale(.97)}
button:disabled{opacity:.48;cursor:not-allowed}
button:focus-visible,select:focus-visible{
 outline:3px solid var(--green);outline-offset:3px
}
.shell{
 width:min(1100px,100%);margin:auto;padding:16px clamp(16px,4vw,40px);
 min-height:100vh;min-height:100dvh;
 display:flex;flex-direction:column;position:relative;z-index:1
}
header{
 display:flex;align-items:center;justify-content:space-between;
 gap:12px;padding:8px 0 18px;border-bottom:1px solid var(--line)
}
.brand{display:flex;align-items:center;gap:10px;font: bold 1.25rem Georgia,serif}
.brand-mark{
 width:40px;height:40px;display:grid;place-items:center;
 background:var(--pink);border-radius:50%;font-size:22px
}
.header-actions{display:flex;gap:8px;flex-wrap:wrap}
.icon-btn{background:var(--paper);border:1px solid var(--line);width:46px;padding:8px;font-size:19px}
main{flex:1;padding:20px 0 12px}
.screen{display:none;animation:appear .35s ease both}
.screen.active{display:block}
@keyframes appear{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
h1,h2,h3{font-family:Georgia,serif}
h1{font-size:clamp(2.5rem,7vw,4.7rem);line-height:1.03;letter-spacing:-.035em;margin:8px 0 16px}
h2{font-size:clamp(1.6rem,4vw,2.3rem);margin:8px 0}
p{line-height:1.55}
.eyebrow{text-transform:uppercase;letter-spacing:.15em;font-size:.76rem;color:var(--pinkdark);font-weight:bold}
.hero{display:grid;grid-template-columns:1.05fr .95fr;gap:28px;align-items:center;padding:20px 0}
.hero-copy p{max-width:480px;color:var(--muted);font-size:1.05rem}
.hero-art{position:relative;min-width:0}
.scene{
 width:100%;display:block;border-radius:45% 45% 15px 15px;
 border:5px solid var(--paper);background:#d9e5d3;
 touch-action:none;user-select:none;-webkit-user-select:none;
 -webkit-touch-callout:none;-webkit-user-drag:none
}
.scene-label{position:absolute;bottom:16px;left:16px;background:var(--paper);border:1px solid var(--line);border-radius:20px;padding:9px 13px;font-size:.82rem}
.primary{background:var(--darkgreen);color:var(--paper);padding:15px 25px}
.secondary{background:var(--pink);color:#472a36}
.soft{background:var(--paper);border:1px solid var(--line)}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}
.note{border-left:4px solid var(--pink);padding:12px 16px;background:rgba(255,248,237,.7);margin-top:20px;font-size:.9rem}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:20px}
.stat{background:#f6eadc;padding:11px 8px;border-radius:12px;text-align:center;min-width:0}
.stat strong{display:block;font-size:1.25rem;overflow-wrap:anywhere}
.stat small{font-size:.72rem;color:var(--muted)}
.game-layout{display:grid;grid-template-columns:minmax(0,1fr) 220px;gap:20px;align-items:start}
.game-main{min-width:0;background:var(--paper);padding:clamp(16px,3vw,28px);border:1px solid var(--line);border-radius:5px 26px;box-shadow:0 12px 35px rgba(76,49,47,.13)}
.game-side{background:var(--darkgreen);color:var(--paper);padding:20px;border-radius:25px 5px}
.progress{height:10px;background:#e8d7c7;border-radius:20px;overflow:hidden;margin:10px 0 24px}
.progress-fill{height:100%;width:0;background:var(--green);transition:width .2s}
.question-tag{display:inline-block;color:var(--pinkdark);font-size:.78rem;font-weight:bold;letter-spacing:.08em}
.question{font:clamp(1.45rem,4vw,2.1rem)/1.35 Georgia,serif;margin:12px 0 7px}
.translation{color:var(--muted);margin:0 0 22px}
.answers{display:grid;grid-template-columns:1fr 1fr;gap:11px}
.answer{
 min-height:65px;text-align:left;background:#f4e9dc;
 border:1px solid var(--line);display:flex;align-items:center;gap:12px
}
.answer .letter{width:32px;height:32px;flex-shrink:0;display:grid;place-items:center;border-radius:50%;background:var(--pink)}
.answer.correct{background:#dcebdc;border-color:var(--good)}
.answer.wrong{background:#f3dddd;border-color:var(--bad)}
.feedback{min-height:54px;padding:12px 14px;margin-top:16px;border-radius:10px;background:#f2e9dc;line-height:1.45}
.feedback.good{background:#dcebdc;color:#245338}
.feedback.bad{background:#f3dddd;color:#842d35}
.next-row{display:flex;justify-content:flex-end;margin-top:12px}
.side-stat{padding:13px 0;border-bottom:1px solid rgba(255,255,255,.2)}
.side-stat strong{font-size:1.5rem;display:block}
.side-stat small{opacity:.8}
.side-tip{font-size:.9rem;line-height:1.55;margin-top:18px;color:#f7e8d7}
.panel{max-width:580px;margin:24px auto;padding:clamp(20px,5vw,34px);background:var(--paper);border:1px solid var(--line);border-radius:6px 28px;box-shadow:0 12px 35px rgba(76,49,47,.13)}
.setting-row{display:flex;justify-content:space-between;align-items:center;gap:15px;padding:14px 0;border-bottom:1px solid var(--line)}
.setting-row select{min-height:44px;padding:8px;background:var(--paper);color:var(--ink);border:1px solid var(--line);border-radius:9px;font-size:16px}
.toggle{min-width:76px;background:#e6d5c7}
.toggle.on{background:#d8e9d7;color:var(--darkgreen)}
footer{padding:12px 0 4px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;color:var(--muted);font-size:.78rem}
.overlay{display:none;position:fixed;inset:0;z-index:10;padding:20px;padding-top:max(20px,env(safe-area-inset-top));padding-bottom:max(20px,env(safe-area-inset-bottom));background:rgba(43,39,34,.72);align-items:center;justify-content:center}
.overlay.show{display:flex}
.overlay-card{background:var(--paper);width:min(460px,100%);padding:28px;border-radius:7px 28px;max-height:90dvh;overflow:auto}
.overlay-card h2{margin-top:0}
.overlay-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}
.petal-canvas{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:0;opacity:.45}
#message{min-height:24px;font-size:.85rem;color:var(--muted)}
@media(max-width:768px){
 .hero{grid-template-columns:1fr;gap:20px}
 .hero-art{max-width:480px;margin:auto;width:100%}
 .game-layout{grid-template-columns:1fr}
 .game-side{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
 .side-stat{border:0;padding:5px}
 .side-tip{grid-column:1/-1;margin:0}
}
@media(max-width:480px){
 .shell{padding:12px 16px}
 header{padding-bottom:12px}
 .brand{font-size:1.05rem}
 .brand-mark{width:36px;height:36px}
 .icon-btn{width:44px;padding:6px}
 .hero{padding:8px 0}
 .hero-copy p{font-size:1rem}
 .actions button{flex:1}
 .answers{grid-template-columns:1fr}
 .answer{min-height:55px}
 .stats{gap:5px}
 .stat{padding:9px 4px}
 .game-main{padding:16px}
 .game-side{padding:13px}
}
@media(min-width:1200px){.shell{padding-top:22px}}
@media(orientation:landscape) and (max-height:600px){
 .shell{padding-top:8px}main{padding-top:8px}
 .hero{grid-template-columns:1fr 1fr}
 .scene{max-height:55vh;object-fit:contain}
}
@media(prefers-reduced-motion:reduce){
 *,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}
 .petal-canvas{display:none}
}
</style>
</head>
<body>
<canvas class="petal-canvas" id="petals" aria-hidden="true"></canvas>
<div class="shell">
<header>
 <div class="brand"><span class="brand-mark" aria-hidden="true">🌸</span><span>Sakura School</span></div>
 <div class="header-actions">
  <button class="icon-btn" id="soundButton" aria-label="Aktifkan atau matikan suara">♪</button>
  <button class="icon-btn" id="settingsButton" aria-label="Pengaturan">⚙</button>
  <button class="icon-btn" id="fullscreenButton" aria-label="Layar penuh">⛶</button>
 </div>
</header>
<main>
<section class="screen active" id="homeScreen">
 <div class="hero">
  <div class="hero-copy">
   <div class="eyebrow">春 · Musim semi di Jepang</div>
   <h1>Belajar Jepang di bawah sakura.</h1>
   <p>Temani Hana berkeliling sekolah. Jawab 100 pertanyaan bahasa Jepang, kumpulkan poin, dan jadilah murid terbaik Sakura Academy!</p>
   <div class="actions">
    <button class="primary" id="startButton">Mulai petualangan →</button>
    <button class="soft" id="howButton">Cara bermain</button>
   </div>
   <div class="note"><strong>今日の言葉 — Kotoba hari ini</strong><br>さくら (Sakura) berarti bunga sakura.</div>
  </div>
  <div class="hero-art">
   <canvas id="scene" class="scene" width="600" height="620" aria-label="Hana di halaman sekolah dengan pohon sakura" draggable="false"></canvas>
   <div class="scene-label">🌸 Halaman sekolah Hana</div>
  </div>
 </div>
 <div class="stats">
  <div class="stat"><strong id="bestHome">0</strong><small>Skor terbaik</small></div>
  <div class="stat"><strong>100</strong><small>Total pertanyaan</small></div>
  <div class="stat"><strong>1.000</strong><small>Skor maksimal</small></div>
 </div>
</section>

<section class="screen" id="gameScreen">
 <div class="game-layout">
  <div class="game-main">
   <div class="stats" aria-live="polite">
    <div class="stat"><strong id="score">0</strong><small>Skor</small></div>
    <div class="stat"><strong id="lives">♥ ♥ ♥</strong><small>Kesempatan</small></div>
    <div class="stat"><strong id="round">1/100</strong><small>Pertanyaan</small></div>
   </div>
   <div class="progress"><div class="progress-fill" id="progressFill"></div></div>
   <span class="question-tag" id="category">KOSAKATA</span>
   <h2 class="question" id="question">Pertanyaan bahasa Jepang</h2>
   <p class="translation" id="questionHint">Pilih jawaban yang tepat.</p>
   <div class="answers" id="answers"></div>
   <div class="feedback" id="feedback" aria-live="polite">Pilih jawabanmu, ya!</div>
   <div class="next-row"><button class="primary" id="nextButton" disabled>Berikutnya →</button></div>
  </div>
  <aside class="game-side">
   <div class="side-stat"><strong id="sideScore">0</strong><small>Total poin</small></div>
   <div class="side-stat"><strong id="sideBest">0</strong><small>Rekor terbaik</small></div>
   <div class="side-stat"><strong>🌸 100</strong><small>Misi Hana</small></div>
   <p class="side-tip">Jawaban benar mendapatkan 10 poin. Baca pertanyaan dengan teliti dan kumpulkan pengetahuan bahasa Jepang!</p>
   <button class="soft" id="pauseButton">Ⅱ Jeda permainan</button>
  </aside>
 </div>
</section>

<section class="screen" id="resultScreen">
 <div class="panel" style="text-align:center">
  <div style="font-size:3.5rem" id="resultEmoji">🌸</div>
  <div class="eyebrow">Petualangan selesai</div>
  <h2 id="resultTitle">Hebat sekali!</h2>
  <p id="resultDescription">Hana senang belajar bersamamu.</p>
  <div class="stats">
   <div class="stat"><strong id="finalScore">0</strong><small>Skor akhir</small></div>
   <div class="stat"><strong id="correctCount">0</strong><small>Benar</small></div>
   <div class="stat"><strong id="wrongCount">0</strong><small>Salah</small></div>
  </div>
  <p id="newRecord"></p>
  <div class="actions" style="justify-content:center">
   <button class="primary" id="replayButton">Main lagi ↻</button>
   <button class="soft" id="homeButton">Menu utama</button>
  </div>
 </div>
</section>

<section class="screen" id="settingsScreen">
 <div class="panel">
  <div class="eyebrow">Pengaturan permainan</div><h2>Atur petualanganmu</h2>
  <div class="setting-row"><span>Efek suara</span><button class="toggle on" id="sfxToggle" aria-pressed="true">Aktif</button></div>
  <div class="setting-row"><span>Tingkat kesulitan</span>
   <select id="difficulty">
    <option value="mudah">Mudah · 10 kesempatan</option>
    <option value="normal">Normal · 5 kesempatan</option>
    <option value="sulit">Sulit · 3 kesempatan</option>
   </select>
  </div>
  <div class="setting-row"><span>Skor terbaik</span><strong id="bestSetting">0</strong></div>
  <div class="actions">
   <button class="primary" id="settingsBack">Simpan & kembali</button>
   <button class="soft" id="resetData">Reset data</button>
  </div>
  <p id="message" aria-live="polite"></p>
 </div>
</section>

<section class="screen" id="howScreen">
 <div class="panel">
  <div class="eyebrow">Panduan Hana</div><h2>Cara bermain</h2>
  <ol style="line-height:1.9;padding-left:22px">
   <li>Tekan mulai petualangan.</li>
   <li>Ada 100 pertanyaan yang diacak setiap permainan.</li>
   <li>Pilih satu dari empat jawaban.</li>
   <li>Jawaban benar mendapatkan 10 poin.</li>
   <li>Jawaban salah mengurangi satu kesempatan.</li>
   <li>Selesaikan 100 soal untuk menuntaskan misi Hana.</li>
  </ol>
  <h3>Kontrol komputer</h3>
  <p><strong>1–4:</strong> memilih jawaban. <strong>Enter/Spasi:</strong> lanjut. <strong>ESC/P:</strong> jeda. <strong>M:</strong> suara. <strong>F:</strong> layar penuh. <strong>R:</strong> mulai ulang dengan konfirmasi.</p>
  <p>Di HP, sentuh tombol pilihan dan tombol yang tersedia.</p>
  <button class="primary" id="howBack">Kembali</button>
 </div>
</section>
</main>
<footer><span>🌸 Sakura School · 日本語を学ぼう</span><span>Belajar sedikit demi sedikit setiap hari.</span></footer>
</div>

<div class="overlay" id="pauseOverlay" role="dialog" aria-modal="true" aria-labelledby="pauseTitle">
 <div class="overlay-card">
  <div style="font-size:2.5rem">🌸</div><h2 id="pauseTitle">Istirahat sebentar?</h2>
  <p>Permainan dihentikan sementara. Progresmu tetap tersimpan selama halaman terbuka.</p>
  <div class="overlay-actions">
   <button class="primary" id="resumeButton">Lanjut bermain</button>
   <button class="soft" id="pauseRestart">Mulai ulang</button>
   <button class="soft" id="exitButton">Menu utama</button>
  </div>
 </div>
</div>
<div class="overlay" id="confirmOverlay" role="dialog" aria-modal="true" aria-labelledby="confirmTitle">
 <div class="overlay-card">
  <h2 id="confirmTitle">Mulai ulang permainan?</h2>
  <p>Progres permainan saat ini akan diganti dengan permainan baru.</p>
  <div class="overlay-actions">
   <button class="primary" id="confirmYes">Ya, mulai ulang</button>
   <button class="soft" id="confirmNo">Batalkan</button>
  </div>
 </div>
</div>
<div class="overlay" id="onboardOverlay" role="dialog" aria-modal="true" aria-labelledby="onboardTitle">
 <div class="overlay-card">
  <div style="font-size:2.7rem">🌸</div><div class="eyebrow">Pertemuan pertama</div>
  <h2 id="onboardTitle">Konnichiwa!</h2>
  <p>Halo! Aku Hana. Ayo belajar bahasa Jepang bersama di sekolah ini.</p>
  <p>Jawab 100 pertanyaan dan kumpulkan poin. Pilih tingkat kesulitan sesuai kemampuanmu.</p>
  <div class="overlay-actions">
   <button class="primary" id="onboardStart">Ayo mulai!</button>
   <button class="soft" id="onboardSkip">Lewati</button>
  </div>
 </div>
</div>
<div id="fatalError" class="overlay" role="alert">
 <div class="overlay-card"><h2>Permainan mengalami kendala</h2><p>Coba muat ulang halaman melalui browser. Jika masalah berlanjut, gunakan Chrome versi terbaru.</p></div>
</div>

<script>
"use strict";
const $=id=>document.getElementById(id);
const TOTAL=100,STORAGE_KEY="app_v1_state";
const DEFAULTS={version:1,best:0,sfx:true,difficulty:"mudah",onboarded:false};

/* Bank 100 pertanyaan. Format: kategori, pertanyaan, petunjuk baca,
   empat pilihan jawaban, indeks jawaban benar. */
const RAW=[
["SALAM","Apa arti おはようございます?","Ohayou gozaimasu",["Selamat pagi","Selamat malam","Terima kasih","Sampai jumpa"],0],
["SALAM","Apa arti こんにちは?","Konnichiwa",["Selamat malam","Halo / selamat siang","Maaf","Selamat pagi"],1],
["SALAM","Apa arti こんばんは?","Konbanwa",["Selamat pagi","Terima kasih","Selamat malam","Sampai jumpa"],2],
["SALAM","Apa arti ありがとう?","Arigatou",["Maaf","Permisi","Selamat datang","Terima kasih"],3],
["SALAM","Apa arti さようなら?","Sayounara",["Sampai jumpa","Selamat pagi","Terima kasih","Halo"],0],
["SALAM","Apa arti すみません?","Sumimasen",["Selamat tidur","Permisi / maaf","Selamat siang","Sama-sama"],1],
["SALAM","Apa arti おやすみなさい?","Oyasuminasai",["Selamat pagi","Selamat datang","Selamat tidur","Terima kasih"],2],
["SALAM","Apa arti はい?","Hai",["Tidak","Mungkin","Maaf","Ya"],3],
["SALAM","Apa arti いいえ?","Iie",["Tidak","Ya","Terima kasih","Halo"],0],
["SALAM","Apa arti おげんきですか?","Ogenki desu ka",["Siapa namamu?","Apa kabar?","Di mana sekolah?","Terima kasih"],1],

["ANGKA","Bagaimana membaca 一?","Ichi",["Ni","San","Ichi","Yon"],2],
["ANGKA","Bagaimana membaca 二?","Ni",["Ichi","Ni","Go","Roku"],1],
["ANGKA","Bagaimana membaca 三?","San",["Yon","Go","San","Nana"],2],
["ANGKA","Bagaimana membaca 四?","Yon / Shi",["Yon","Ichi","Hachi","San"],0],
["ANGKA","Bagaimana membaca 五?","Go",["Roku","Nana","Ni","Go"],3],
["ANGKA","Bagaimana membaca 六?","Roku",["Roku","Hachi","Ku","Ju"],0],
["ANGKA","Bagaimana membaca 七?","Nana / Shichi",["Go","Nana","San","Ni"],1],
["ANGKA","Bagaimana membaca 八?","Hachi",["Ku","Ju","Hachi","Roku"],2],
["ANGKA","Bagaimana membaca 九?","Kyuu / Ku",["Ichi","Ni","Go","Kyuu"],3],
["ANGKA","Bagaimana membaca 十?","Juu",["Juu","San","Yon","Nana"],0],

["SEKOLAH","Apa arti 学校?","Gakkou",["Rumah","Sekolah","Taman","Toko"],1],
["SEKOLAH","Apa arti 教室?","Kyoushitsu",["Perpustakaan","Kantin","Ruang kelas","Lapangan"],2],
["SEKOLAH","Apa arti 図書館?","Toshokan",["Perpustakaan","Kantor","Rumah","Toilet"],0],
["SEKOLAH","Apa arti 体育館?","Taiikukan",["Kantin","Laboratorium","Ruang guru","Gedung olahraga"],3],
["SEKOLAH","Apa arti 校長先生?","Kouchou sensei",["Murid","Kepala sekolah","Teman","Penjaga"],1],
["SEKOLAH","Apa arti 先生?","Sensei",["Guru","Murid","Buku","Teman"],0],
["SEKOLAH","Apa arti 生徒?","Seito",["Guru","Kepala sekolah","Murid","Orang tua"],2],
["SEKOLAH","Apa arti 友達?","Tomodachi",["Guru","Keluarga","Tetangga","Teman"],3],
["SEKOLAH","Apa arti 授業?","Jugyou",["Pelajaran","Liburan","Permainan","Makanan"],0],
["SEKOLAH","Apa arti 宿題?","Shukudai",["Ujian","Pekerjaan rumah","Istirahat","Olahraga"],1],

["BENDA","Apa arti 本?","Hon",["Pensil","Tas","Buku","Meja"],2],
